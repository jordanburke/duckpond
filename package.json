    "functype": "^0.41.3",
    "lru-cache": "^11.2.4"
  },
  "devDependencies": {
    "@types/node": "~24.10.4",
    "ts-builds": "^2.1.0",
    "tsdown": "^0.18.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
